# 夜跑闭环模板必须保持 LF：bash 与 cron/systemd 解析器都不容忍 CRLF，
# Windows 检出时也不要转换
skills/lazypack-setup/assets/mutation/scripts/*.sh text eol=lf
skills/lazypack-setup/assets/mutation/config/* text eol=lf

# setup native Hook template must remain executable by Git for Windows.
skills/lazypack-setup/templates/pre-commit.sh text eol=lf
